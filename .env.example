# ==============================================================================
# DEFENDER BOT - PRODUCTION CONFIGURATION ENVIRONMENT VARIABLES
# ==============================================================================
# Eslatma: Ushbu fayldan nusxa oling (.env nomi bilan) va o'zingizning haqiqiy
# parametr va maxfiy kalitlaringizni kiriting. Hech qachon haqiqiy .env faylini
# git repositoriyasiga commit qilmang!

# ------------------------------------------------------------------------------
# 1. TELEGRAM BOT SOZLAMALARI
# ------------------------------------------------------------------------------
# @BotFather orqali olingan bot tokeni
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_EXAMPLE

# Bot asosiy egasining (Owner) Telegram raqamli ID si (@userinfobot orqali olish mumkin)
OWNER_ID=123456789

# Qo'shimcha administratorlar Telegram ID lari (vergul bilan ajratilgan)
ADMINS=123456789,987654321

# Administrator username (foydalanuvchilar bilan bog'lanish uchun, @ siz)
ADMIN_USERNAME=ads_bot_service

# ------------------------------------------------------------------------------
# 2. GURUH VA MODERATSIYA NISHONLARI
# ------------------------------------------------------------------------------
# Moderatsiya qilinadigan asosiy guruh ID si (masalan: -1001234567890).
# Bo'sh qoldirilsa, bot qo'shilgan barcha guruhlarda ishlaydi.
TARGET_GROUP_ID=-1001234567890

# Tasdiqlangan reklamalar e'lon qilinadigan alohida kanal/guruh ID si (ixtiyoriy).
# Bo'sh qoldirilsa, reklama o'chirilgan original guruhga e'lon qilinadi.
AD_PUBLISH_CHANNEL_ID=

# ------------------------------------------------------------------------------
# 3. TIJORIY REKLAMA VA TO'LOV REKVIZITLARI
# ------------------------------------------------------------------------------
# Reklama to'lovlari qabul qilinadigan karta raqami
AD_PAYMENT_CARD=8600 0000 0000 0000

# Karta egasining to'liq ism-sharifi
AD_CARDHOLDER_NAME=FALONCHI PISMATONCHIYEV

# Reklama uchun standart narx (so'mda)
AD_PRICE=150000

# Reklama narxining ruxsat etilgan chegaralari (so'mda)
MIN_AD_PRICE=1000
MAX_AD_PRICE=100000000

# ------------------------------------------------------------------------------
# 4. MA'LUMOTLAR BAZASI (POSTGRESQL) VA REDIS
# ------------------------------------------------------------------------------
# Asinxron PostgreSQL ulanish manzili (asyncpg drayveri bilan)
DATABASE_URL=postgresql+asyncpg://defender_user:StrongPassword123@localhost:5432/defender_bot

# Redis ulanish manzili (keshlash, tarqatilgan qulflar va rate limiting uchun, ixtiyoriy)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 5. MODERATSIYA VA DETEKTOR SOZLAMALARI
# ------------------------------------------------------------------------------
# Reklama deb baholash minimal ishonchlilik bali (0 dan 100 gacha, tavsiya: 40)
ADVERTISEMENT_THRESHOLD=40

# Ogohlantirish xabarini guruhdan necha soniyadan so'ng o'chirish (0 - o'chirmaslik)
WARNING_DELETE_SECONDS=0

# Guruh ma'murlari xabarlarini ham tekshirish (false tavsiya etiladi)
FILTER_ADMINS=false

# Avtomatik jazolash (mute / ban eskalatsiyasi)
AUTO_MUTE=false
AUTO_BAN=false

# Rasmlardagi yozuvlarni aniqlash (OCR Tesseract)
OCR_ENABLED=true
TESSERACT_CMD=

# ------------------------------------------------------------------------------
# 6. LOGGING VA WEB ADMIN PANEL
# ------------------------------------------------------------------------------
# Log darajasi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Web boshqaruv paneli faolligi
WEB_ADMIN_ENABLED=true
WEB_ADMIN_HOST=0.0.0.0
WEB_ADMIN_PORT=8000

# Web admin sessiyasi maxfiy shifrlash kaliti (ishlab chiqarishda o'zgartiring!)
WEB_ADMIN_SECRET_KEY=generate-a-secure-random-secret-key-for-session-tokens-here

# Web admin boshlang'ich login va paroli
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=change_this_secure_admin_password_in_prod

# Telegram proksi (agar serveringizda Telegram bloklangan bo'lsa, aks holda bo'sh)
TELEGRAM_PROXY=

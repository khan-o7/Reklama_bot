# ==========================================
# TELEGRAM DEFENDER BOT CONFIGURATION
# ==========================================

# Telegram Bot API token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ123456789

# Bot Owner Telegram ID (Primary SuperAdmin)
OWNER_ID=123456789

# Additional Admin Telegram IDs (comma-separated, no spaces)
ADMINS=123456789,987654321

# Support / Admin Telegram username for the warning button (without @)
ADMIN_USERNAME=my_admin_username

# PostgreSQL Async Database URL (asyncpg driver)
# Local: postgresql+asyncpg://postgres:postgres@localhost:5432/defender_bot
# Docker Compose: postgresql+asyncpg://postgres:postgres@postgres:5432/defender_bot
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/defender_bot

# Moderation Defaults
WARNING_DELETE_SECONDS=15
ADVERTISEMENT_THRESHOLD=40
AUTO_MUTE=true
AUTO_BAN=true
FILTER_ADMINS=false

# Escalation Actions (options: warning, mute_10m, mute_1h, mute_24h, ban)
FIRST_ACTION=warning
SECOND_ACTION=mute_10m
THIRD_ACTION=mute_1h
FOURTH_ACTION=ban

# Logging Settings (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Web Admin Panel Configuration
WEB_ADMIN_ENABLED=true
WEB_ADMIN_HOST=0.0.0.0
WEB_ADMIN_PORT=8000
WEB_ADMIN_SECRET_KEY=super-secret-random-key-change-this-in-production-123456789
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=admin12345
